# Validates that control/ pointer files stay short and don't accumulate journal-style content.
# Replace <NOTES_VAULT_PATH> and <PROJECT_NAME> with the values for this project.

param(
    [string]$NotesRoot = "<NOTES_VAULT_PATH>/projects/<PROJECT_NAME>",
    [string]$RepoRoot = ""
)

$ErrorActionPreference = "Stop"

if ([string]::IsNullOrWhiteSpace($RepoRoot)) {
    if (-not [string]::IsNullOrWhiteSpace($PSScriptRoot)) {
        $RepoRoot = (Resolve-Path (Join-Path $PSScriptRoot '..')).Path
    } else {
        $RepoRoot = (Get-Location).Path
    }
}

$state = Join-Path $NotesRoot "control/STATE.md"
$tasks = Join-Path $NotesRoot "control/TASKS.md"
$guardrails = Join-Path $NotesRoot "control/CODEX_GUARDRAILS.md"
$backlog = Join-Path $NotesRoot "tasks/backlog.md"

$limits = @(
    @{ Path = $state; Name = "STATE.md"; MaxLines = 60 },
    @{ Path = $tasks; Name = "TASKS.md"; MaxLines = 60 },
    @{ Path = $guardrails; Name = "CODEX_GUARDRAILS.md"; MaxLines = 80 }
)

$failed = $false

function Report-Failure {
    param([string]$Message)
    Write-Host "ERROR $Message" -ForegroundColor Red
    $script:failed = $true
}

foreach ($item in $limits) {
    if (-not (Test-Path $item.Path)) {
        Report-Failure "$($item.Name) missing at $($item.Path)"
        continue
    }

    $lines = @(Get-Content -LiteralPath $item.Path)
    $count = $lines.Count
    if ($count -gt $item.MaxLines) {
        Report-Failure "$($item.Name) has $count lines; limit is $($item.MaxLines). Move open/deferred work to tasks/backlog.md, plans to tasks/audits/, completed work to tasks/archive/YYYY-MM-done.md, session history to sessions/, and deploy history to reference-version-history.md."
    } else {
        Write-Host "OK $($item.Name): $count/$($item.MaxLines) lines"
    }
}

$instructionLimits = @(
    @{ Path = (Join-Path $RepoRoot "AGENTS.md"); Name = "AGENTS.md"; TargetLines = 150; WarnLines = 180; MaxLines = 220 },
    @{ Path = (Join-Path $RepoRoot "CLAUDE.md"); Name = "CLAUDE.md"; TargetLines = 150; WarnLines = 180; MaxLines = 220 }
)

foreach ($item in $instructionLimits) {
    if (-not (Test-Path $item.Path)) {
        continue
    }

    $lines = @(Get-Content -LiteralPath $item.Path)
    $count = $lines.Count
    if ($count -gt $item.MaxLines) {
        Report-Failure "$($item.Name) has $count lines; hard limit is $($item.MaxLines). Move long checklists/runbooks to reference/ and leave path pointers."
    } elseif ($count -gt $item.WarnLines) {
        Write-Warning "$($item.Name) has $count lines; target is $($item.TargetLines), warning threshold is $($item.WarnLines). Consider moving detail to reference/ and linking paths."
    } else {
        Write-Host "OK $($item.Name): $count/$($item.WarnLines) warning threshold ($($item.MaxLines) hard max)"
    }
}

if (Test-Path $backlog) {
    $backlogLines = @(Get-Content -LiteralPath $backlog)
    if ($backlogLines.Count -gt 150) {
        Write-Warning "tasks/backlog.md has $($backlogLines.Count) lines; target is 150. Split or archive stale backlog items."
    } else {
        Write-Host "OK tasks/backlog.md: $($backlogLines.Count)/150 target"
    }
}

$tasksText = Get-Content -Raw -LiteralPath $tasks
$focusMatches = [regex]::Matches($tasksText, "(?m)^- \*\*")
if ($focusMatches.Count -gt 5) {
    Report-Failure "TASKS.md has $($focusMatches.Count) bold task/watch bullets; keep 3-5 total."
} else {
    Write-Host "OK TASKS.md focus/watch bullets: $($focusMatches.Count)/5"
}

$blockedHeadings = @("## Recent Notes", "## Recently Done")
foreach ($heading in $blockedHeadings) {
    foreach ($file in @($state, $tasks)) {
        if ((Get-Content -Raw -LiteralPath $file).Contains($heading)) {
            Report-Failure "$(Split-Path $file -Leaf) contains '$heading'; control files should link detail files, not journal history."
        }
    }
}

if ($failed) { exit 1 }
Write-Host "Control hygiene passed."
